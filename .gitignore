# OSCAR - .gitignore

# Python & Environment
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Local databases and caches
*.sqlite3
*.db
*.db-shm
*.db-wal
*.db-journal
backend/oscar.db*
backend/storage/statements/*
!backend/storage/statements/.gitkeep

# Environment & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Node & Frontend
node_modules/
frontend/dist/
frontend/build/
.npm
.eslintcache

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Logs & Temporary files
*.log
.chrome_temp/
.chrome_temp*/
.runtime/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp/
temp/
