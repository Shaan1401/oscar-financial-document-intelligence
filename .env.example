# OSCAR Environment Configuration
# Copy this file to .env for local overrides

# Application
APP_NAME=OSCAR
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Server
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Storage & Database
DATABASE_URL=sqlite:///./oscar.db
STORAGE_DIR=./backend/storage/statements
ML_ARTIFACTS_DIR=./backend/ml_artifacts

# OCR (Tesseract)
# Set to explicit path if Tesseract is not in system PATH, e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# File Upload Limits
MAX_UPLOAD_SIZE_BYTES=20971520 # 20 MB

# Classification Thresholds
ML_CONFIDENCE_THRESHOLD=0.65
