# OSCAR — Operational Statement Classification, Analysis & Reconciliation
# Environment Configuration Template
# Copy this file to .env for local overrides if needed.
# By default, OSCAR runs out of the box with zero configuration on Windows.

# Application Information
APP_NAME=OSCAR
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Server & Network Configuration
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Storage & Database Configuration
# By default, OSCAR automatically anchors the persistent SQLite database to:
# backend/oscar.db (eliminating working-directory drift across CLI, tests, and launchers).
# Leave commented out for default behavior. Uncomment only to override with an external
# database (e.g. PostgreSQL) or custom absolute SQLite file path:
# DATABASE_URL=sqlite:///./backend/oscar.db

# File Storage Paths (automatically anchored to backend/ if omitted)
# STORAGE_DIR=backend/storage/statements
# ML_ARTIFACTS_DIR=backend/ml_artifacts

# Physical Tesseract OCR Engine Configuration
# On Windows, OSCAR automatically probes C:\Program Files\Tesseract-OCR\tesseract.exe
# and system PATH. Set an explicit path below only if installed in a custom location:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# File Upload Limits
MAX_UPLOAD_SIZE_BYTES=20971520 # 20 MB

# Classification Thresholds (Confidence Gate)
ML_CONFIDENCE_THRESHOLD=0.65
